# OpenAI / OpenRouter (for AI stock analysis)
OPENAI_API_KEY=your_openai_or_openrouter_key

# News API (optional)
NEWS_API_KEY=your_news_api_key

# Upstox (API Key & Secret used ONLY in backend; never in React)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
# Must match EXACTLY the redirect URI set in Upstox developer dashboard
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback
UPSTOX_TOKEN_FILE=upstox_token.json

# Optional: where to send user after successful Upstox login (default: same origin as callback)
# UPSTOX_FRONTEND_REDIRECT_URI=http://localhost:5173
